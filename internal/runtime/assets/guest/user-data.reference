      border_color = #121916 0
      background_color_hover = #24332c 100
      background_color_pressed = #1b2621 100
      
      rounded = 8
      border_width = 0
      background_color = #2f4a3e 100
      border_color = #2f4a3e 0
      
      rounded = 10
      border_width = 0
      background_color = #1b2621 0
      border_color = #1b2621 0
      
      panel_monitor = all
