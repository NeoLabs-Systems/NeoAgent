      task_padding = 10 4 8
      task_background_id = 3
      task_active_background_id = 2
      task_tooltip = 1
      urgent_nb_of_blink = 8
      
      systray_padding = 4 0 6
      systray_icon_size = 18
      systray_icon_asb = 100 0 0
      
      clock_format = %a %H:%M
      clock_font = sans 9
      clock_font_color = #e8efe6 100
      clock_padding = 10 0
      clock_background_id = 3
