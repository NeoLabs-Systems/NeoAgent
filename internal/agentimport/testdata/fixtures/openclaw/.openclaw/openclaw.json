    second: { baseUrl: 'https://second.test/v1', api: 'openai-completions' },
    openai: { apiKey: { source: 'env', id: 'OPENAI_API_KEY' } },
  } },
  mcp: { servers: {
    remote: { url: 'https://mcp.example.test/sse', headers: { Authorization: 'Bearer ${MCP_TOKEN}', 'X-Team': 'blue' } },
    off: { url: 'https://mcp2.example.test/mcp', enabled: false, transport: 'streamable-http' },
    local: { command: 'npx', args: ['-y', 'fs'], env: { API_TOKEN: 'abc', PLAIN: 'p' } },
  } },
  channels: {
    telegram: { botToken: '${TG_TOKEN}', allowFrom: ['@alice', '12345', '*'], dm: { allowFrom: ['999'] } },
    discord: { token: 'dtok', accounts: { a: { enabled: true }, b: { enabled: true } } },
    whatsapp: { allowFrom: ['+4915112345678'] },
    slack: { enabled: true },
    matrix: { enabled: true },
  },
