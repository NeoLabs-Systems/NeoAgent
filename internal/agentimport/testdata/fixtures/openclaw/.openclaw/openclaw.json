// hand edited
{
  agents: {
    defaults: { model: { primary: 'anthropic/claude-sonnet-4' }, models: { 'openrouter/acme/x1': { alias: 'fast' } }, workspace: '~/openclaw/ws' },
    list: [
      { id: 'main', default: true, identity: { name: 'Jarvis' }, workspace: '~/openclaw/ws' },
      { id: 'helper', name: 'Helper Bot', model: 'fast', workspace: '~/openclaw/helper-ws' },
    ],
  },
  env: { vars: { BRAVE_API_KEY: 'brave-123' }, EXTRA: 'x' },
  models: { providers: {
    ollama: { baseUrl: 'http://localhost:11434/v1' },
