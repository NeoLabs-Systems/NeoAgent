 ],
 "notifications": [
  "{\"user_id\":1,\"app_package\":\"unknown\",\"title\":\"\",\"body\":\"\",\"action_taken\":\"none\",\"title_type\":\"text\"}",
  "{\"user_id\":1,\"app_package\":\"com.whatsapp\",\"title\":\"Ada\",\"body\":\"Lunch? <b>now</b>\",\"action_taken\":\"replied\",\"title_type\":\"text\"}",
