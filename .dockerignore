# Allowlist: the build context holds only what the image builds and runs.
# Everything else, including the repository's .env with live secrets, never
# leaves this machine.
*
!go.mod
!go.sum
!cmd/
!internal/
!landing/
!public/
!LICENSE

# Secrets and local state can still sit inside the allowed folders.
**/.env
**/.env.*
**/*.env
**/.DS_Store
**/testdata
**/*_test.go
