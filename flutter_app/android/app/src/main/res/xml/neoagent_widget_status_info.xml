<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis re-renders from storage, so a snapshot left by an app that
     has since died stops claiming to be live. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/neoagent_widget_status_description"
    android:initialLayout="@layout/neoagent_widget_status"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:previewImage="@mipmap/ic_launcher"
    android:previewLayout="@layout/neoagent_widget_status"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
