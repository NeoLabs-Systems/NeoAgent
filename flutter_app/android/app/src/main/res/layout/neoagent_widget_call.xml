<?xml version="1.0" encoding="utf-8"?>
<!-- Just the mascot on the wallpaper, sized from code to the widget's smaller side.
     The face keeps a square: a ProgressBar stretches an animation to its bounds. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="@string/neoagent_widget_talk"
    android:padding="@dimen/neoagent_widget_avatar_inset">

    <FrameLayout
        android:id="@+id/neoagent_widget_avatar"
        android:layout_width="@dimen/neoagent_widget_avatar_size"
        android:layout_height="@dimen/neoagent_widget_avatar_size"
        android:layout_gravity="center">

        <FrameLayout
            android:id="@+id/neoagent_widget_face"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <include layout="@layout/neoagent_widget_face_idle" />
        </FrameLayout>

        <ImageView
            android:id="@+id/neoagent_widget_call_badge"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/neoagent_widget_accent_circle"
            android:importantForAccessibility="no"
            android:padding="5dp"
            android:src="@drawable/ic_neoagent_widget_call" />
    </FrameLayout>
</FrameLayout>
