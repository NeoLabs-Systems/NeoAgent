<?xml version="1.0" encoding="utf-8"?>
<!-- The app's glass panel: surface gradient, a gold wash from the top corner, hairline edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/neoagent_widget_radius" />
            <gradient
                android:angle="270"
                android:endColor="@color/neoagent_widget_surface_bottom"
                android:startColor="@color/neoagent_widget_surface_top" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/neoagent_widget_radius" />
            <gradient
                android:centerX="0.12"
                android:centerY="0"
                android:endColor="@android:color/transparent"
                android:gradientRadius="120%"
                android:startColor="@color/neoagent_widget_glow"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/neoagent_widget_radius" />
            <stroke
                android:width="1dp"
                android:color="@color/neoagent_widget_border" />
        </shape>
    </item>
</layer-list>
