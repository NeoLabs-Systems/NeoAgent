<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>NeoAgent</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>neoagent_flutter</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.neoagent.neoagentFlutter</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>neoagent</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>NeoAgent uses Bluetooth to connect to nearby devices.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_neoagent._tcp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>NeoAgent scans the QR code to approve a sign-in on another device.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>NeoAgent shares your calendars with your agent so it can answer schedule questions and add events for you.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>NeoAgent shares your calendars with your agent so it can answer schedule questions and add events for you.</string>
	<key>NSContactsUsageDescription</key>
	<string>NeoAgent shares your contacts with your agent so it can find people and add new contacts for you.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>NeoAgent reads your steps, heart rate, sleep, workouts and weight so your agent can use them.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>NeoAgent finds your self-hosted server on the local network.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>NeoAgent checks your location in the background for location triggers you set up.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>NeoAgent uses your location for location triggers you set up.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>NeoAgent listens during voice calls with your agent.</string>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.neoagent.device-sync</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
